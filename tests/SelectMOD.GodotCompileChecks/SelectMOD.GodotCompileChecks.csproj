    <DefineConstants>$(DefineConstants);ACTUAL_GODOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/SelectMOD/*.cs" Link="Production/%(Filename)%(Extension)" />
